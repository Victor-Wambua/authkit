    "/api/mfa/setup": {
      "post": {
        "tags": [
          "two-factor"
        ],
        "summary": "Start TOTP enrolment",
        "description": "Creates a pending secret and returns the otpauth URI plus a server-rendered QR (SVG).\n\nTwo-factor stays off until `/mfa/enable` is called with a valid code.",
        "operationId": "setup_api_mfa_setup_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaSetupOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/mfa/enable": {
      "post": {
        "tags": [
          "two-factor"
        ],
        "summary": "Confirm enrolment",
        "description": "Returns ten single-use recovery codes. They are shown once and stored only as hashes.",
        "operationId": "enable_api_mfa_enable_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
