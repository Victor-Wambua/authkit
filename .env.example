# Copy to .env for local overrides. Never commit real values.
# Every setting is optional; see src/authkit/config.py for the full list and defaults.

# "dev" turns on the file mailer, auto-created keys, the dev mailbox and /docs.
# The default is "production", which refuses to start without a keys file and an SMTP mailer.
AUTHKIT_ENV=dev

AUTHKIT_DATABASE_URL=sqlite:///./data/authkit.db
AUTHKIT_KEYS_FILE=./data/keys.json
AUTHKIT_BASE_URL=http://localhost:8000

# Passwords: Argon2id cost (measure on your host: uv run python scripts/tune_argon2.py)
AUTHKIT_ARGON2_MEMORY_KIB=65536
AUTHKIT_ARGON2_TIME_COST=3
AUTHKIT_ARGON2_PARALLELISM=1
AUTHKIT_PASSWORD_MIN_LENGTH=12
# off | offline (local sorted SHA-1 file) | hibp (real range API)
AUTHKIT_BREACH_MODE=offline
# AUTHKIT_BREACH_FILE=/path/to/pwned-passwords-sha1-ordered.txt

# Tokens
AUTHKIT_ACCESS_TTL_SECONDS=900
AUTHKIT_REFRESH_TTL_SECONDS=1209600
AUTHKIT_SESSION_MAX_AGE_SECONDS=2592000

# Throttling
AUTHKIT_ACCOUNT_FREE_ATTEMPTS=5
AUTHKIT_ACCOUNT_LOCKOUT_THRESHOLD=10
AUTHKIT_THROTTLE_WINDOW_SECONDS=900
AUTHKIT_THROTTLE_LOCKOUT_SECONDS=900

# HTTP. Only raise TRUSTED_PROXY_HOPS if a proxy you control appends X-Forwarded-For.
AUTHKIT_CORS_ORIGINS=
AUTHKIT_TRUSTED_PROXY_HOPS=0
AUTHKIT_MAX_BODY_BYTES=65536

# Mail: "file" (dev only) or "smtp"
AUTHKIT_MAILER=file
# AUTHKIT_SMTP_HOST=smtp.example.org
# AUTHKIT_SMTP_PORT=587
# AUTHKIT_SMTP_USERNAME=
# AUTHKIT_SMTP_PASSWORD=
# AUTHKIT_SMTP_FROM=Authkit <no-reply@example.org>
